#!/bin/sh
# ==============================================================================
# Hook Git : pre-commit
# Description : Empêche le commit de fichiers d'environnement sensibles (.env*).
#
# Références et documentation :
#   - Documentation officielle Git Hooks :
#     https://git-scm.com/book/fr/v2/Personnalisation-de-Git-Crochets-Git
#   - Modèle initial : Notes de cours et travaux pratiques (TP1 & TP2) du cours
#     "Infrastructure technologique et virtualisation" (2026), Cégep de Sainte-Foy
#     https://www.cegep-ste-foy.qc.ca/
#   - Optimisation multiplateforme (Windows/Git Bash) et regex :
#     Google Gemini (https://gemini.google.com/)
# ==============================================================================

echo "-----------------------------------------------------------------"
echo "🔍 Vérification du code avant le commit..."

# Détecte tout fichier nommé .env ou contenant .env
if git diff --cached --name-only | grep -E "(^|/)\.env" > /dev/null 2>&1; then
  echo "❌ ERREUR : Tu essaies de committer un fichier .env !"
  echo "   Ajoute-le à ton .gitignore."
  exit 1
fi

echo "✅ Vérification pre-commit réussie."
exit 0