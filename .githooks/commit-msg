#!/bin/bash
# ==============================================================================
# Hook Git : commit-msg
# Description : Valide que les messages respectent la norme Conventional Commits.
#
# Références et documentation :
#   - Spécification officielle Conventional Commits v1.0.0 :
#     https://www.conventionalcommits.org/fr/v1.0.0/
#   - Tutoriel de base pour l'implémentation du hook (mu88) :
#     https://mu88.github.io/2022/07/29/Git-hook-conventional-commit.html
#   - Documentation Git sur le hook commit-msg :
#     https://git-scm.com/docs/githooks#_commit_msg
#   - Travaux pratiques antérieurs : Cours "Infrastructure technologique et virtualisation"
#     (2026), Cégep de Sainte-Foy : https://www.cegep-ste-foy.qc.ca/
#   - Correction syntaxique Bash, support regex et nettoyage CRLF :
#     Google Gemini (https://gemini.google.com/)
# ==============================================================================

echo "-----------------------------------------------------------------"
echo "🔍 Verification - Commit message conformity..."

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# 1. Ignorer les merges, reverts ou commits initiaux automatiques
if echo "$COMMIT_MSG" | grep -qE "^(Merge branch|Revert |Initial commit)"; then
  echo "✅ Message validation bypassed (merge/initial commit)."
  exit 0
fi

# 2. Définition du pattern Conventional Commits
ALLOWED_TYPES_REGEXP="^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9_-]+\))?!?: .+$"

# 3. Validation du message
if [[ ! $COMMIT_MSG =~ $ALLOWED_TYPES_REGEXP ]]; then
  echo -e "❌ ERROR : Invalid commit message format !"
  echo -e "The commit message does not follow the \033[1;36mConventional Commits\033[0m specifications !"
  echo -e "\n\033[1;33mConventional Commits expected formats are :\033[0m"
  echo -e "  \033[32mtype(scope)?: description\033[0m"
  echo -e "  \033[32mfeat(auth)!: add OAuth2 login flow\033[0m (breaking change example)"
  echo -e "\n\033[1;33mAllowed Types : \033[0m"
  echo -e "  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert."
  echo -e "\n\033[1;33mMessage examples : \033[0m"
  echo -e "  feat(auth): add login button"
  echo -e "  fix: resolve memory leak"
  echo -e "\nYour message was: \"$COMMIT_MSG\""
  echo -e "Please review the message and try again."
  exit 1
fi

echo "✅ Message de commit conforme."
exit 0